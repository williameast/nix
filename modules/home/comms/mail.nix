# Mail tooling for the accounts in ./accounts.nix:
# mbsync fetches, notmuch indexes and tags, msmtp sends. Passwords come from
# agenix (./secrets.nix). Emacs (Doom :email notmuch) reads
# ~/.config/emacs-mail/accounts.el, which is generated here too, so the Emacs
# config never names an account.
{ config, lib, pkgs, ... }:

let
  accounts = lib.attrValues config.accounts.email.accounts;
  notmuch = "${pkgs.notmuch}/bin/notmuch";

  elispString = s: "\"${lib.escape [ "\\" "\"" ] s}\"";
  addressRegexp = a: elispString (lib.escapeRegex a.address);

  accountsEl = ''
    ;;; accounts.el --- generated by home-manager (modules/home/comms/mail.nix) -*- lexical-binding: t; -*-
    ;; Do not edit; change ~/.config/nix-config/modules/home/comms/accounts.nix instead.

    ;; Where sent mail is filed.
    (setq notmuch-fcc-dirs
          '(${lib.concatMapStringsSep "\n            " (a:
              "(${addressRegexp a} . ${elispString "${a.name}/${a.folders.sent} +sent -inbox -unread"})")
            accounts}))

    (setq notmuch-saved-searches
          (append
           '((:name "inbox"   :query "tag:inbox" :key "i")
             (:name "unread"  :query "tag:unread and tag:inbox" :key "u")
             (:name "flagged" :query "tag:flagged" :key "f")
             (:name "sent"    :query "tag:sent" :key "t")
             (:name "drafts"  :query "tag:draft" :key "d"))
           '(${lib.concatMapStringsSep "\n             " (a:
              "(:name ${elispString "inbox/${a.name}"} :query ${elispString "tag:inbox and tag:${a.name}"})")
             accounts})))
  '';

  # Tag new mail with its account, file sent mail, then move it to the inbox.
  postNew = ''
    ${lib.concatMapStringsSep "\n" (a: ''
      ${notmuch} tag +${a.name} -- tag:new and 'path:${a.name}/**'
      ${notmuch} tag -new +sent -- tag:new and 'folder:"${a.name}/${a.folders.sent}"'
      ${notmuch} tag -new +draft -- tag:new and 'folder:"${a.name}/${a.folders.drafts}"'
      ${notmuch} tag -new +deleted -- tag:new and 'folder:"${a.name}/${a.folders.trash}"'
    '') accounts}
    ${notmuch} tag -new +inbox +unread -- tag:new
  '';

  syncMail = pkgs.writeShellScript "sync-mail" ''
    # Keep going when one account fails (e.g. not signed in yet).
    ${config.programs.mbsync.package}/bin/mbsync --all
    status=$?
    ${notmuch} new
    exit $status
  '';

  # `mail-add`: add a Purelymail mailbox. Asks for the address and password,
  # encrypts the password with agenix and adds the account to ./accounts.nix
  # (./secrets.nix picks the secret up from there).
  mailAdd = pkgs.writeShellApplication {
    name = "mail-add";
    runtimeInputs = [ pkgs.rage pkgs.git pkgs.gawk ];
    text = ''
      repo=${config.home.homeDirectory}/.config/nix-config
      accounts=$repo/modules/home/comms/accounts.nix

      read -rp "Email address: " address
      if [[ $address != *@*.* ]]; then
        echo "Not an email address: $address" >&2
        exit 1
      fi

      # william@bogen43.de -> secret william_at_bogen43_de, account bogen43-william
      secret=''${address//@/_at_}
      secret=''${secret//./_}
      domain=''${address#*@}
      default=''${domain%.*}-''${address%@*}
      read -rp "Account name [$default]: " name
      name=''${name:-$default}
      if grep -qE "^ +$name +=" "$accounts" && ! grep -qF "\"$address\"" "$accounts"; then
        echo "Account name $name is taken; pick another." >&2
        exit 1
      fi

      read -rsp "Password: " password
      echo
      if [[ -z $password ]]; then
        echo "Empty password, nothing changed." >&2
        exit 1
      fi

      printf '%s' "$password" \
        | rage -e -R ${config.home.homeDirectory}/.ssh/id_ed25519.pub -o "$repo/secrets/$secret.age"
      git -C "$repo" add "secrets/$secret.age"
      echo "Encrypted password: secrets/$secret.age"

      if grep -qF "\"$address\"" "$accounts"; then
        echo "$address is already in accounts.nix."
      else
        # Insert after the last Purelymail account.
        line=$(printf '    %-22s = p.purelymail "%s";' "$name" "$address")
        awk -v line="$line" '
          NR == FNR { if (/= p\.purelymail "/) last = FNR; next }
          { print }
          FNR == last { print line }
        ' "$accounts" "$accounts" > "$accounts.tmp"
        mv "$accounts.tmp" "$accounts"
        echo "Added to accounts.nix: $line"
      fi

      read -rp "Rebuild now? [y/N] " answer
      if [[ $answer == [yY]* ]]; then
        sudo nixos-rebuild switch --flake "$repo#$(< /proc/sys/kernel/hostname)"
        echo "Thunderbird asks for the password once; copy it with:"
        echo "  wl-copy < /run/user/1000/agenix/$secret"
      fi
    '';
  };
in
{
  accounts.email.maildirBasePath = "${config.xdg.dataHome}/mail";

  home.packages = [ mailAdd ];

  programs.mbsync.enable = true;
  programs.msmtp.enable = true;

  programs.notmuch = {
    enable = true;
    new.tags = [ "new" ];
    search.excludeTags = [ "deleted" "spam" ];
    hooks.postNew = postNew;
  };

  xdg.configFile."emacs-mail/accounts.el".text = accountsEl;

  # Fetch every 5 minutes, then index.
  systemd.user.services.sync-mail = {
    Unit = {
      Description = "Fetch mail (mbsync) and index it (notmuch)";
      After = [ "agenix.service" ];
    };
    Service = {
      Type = "oneshot";
      ExecStart = "${syncMail}";
    };
  };
  systemd.user.timers.sync-mail = {
    Unit.Description = "Fetch mail every 5 minutes";
    Timer = {
      OnBootSec = "2m";
      OnUnitInactiveSec = "5m";
    };
    Install.WantedBy = [ "timers.target" ];
  };
}
